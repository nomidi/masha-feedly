{
  "name": "kooperativeweb/masha-feedly",
  "description": "Masha-Feedly-Einträge und Kommentare für Silverstripe CMS",
  "type": "silverstripe-vendormodule",
  "license": "MIT",
  "require": {
    "guzzlehttp/guzzle": "^7.9",
    "php": ">=8.3",
    "silverstripe/asset-admin": "^2.4",
    "silverstripe/cms": "^5.4",
    "unclecheese/display-logic": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  },
  "autoload": {
    "files": [
      "src/Compatibility/SilverStripe5ValidationResult.php"
    ],
    "psr-4": {
      "KW\\MashaFeedly\\": "src/"
    }
  },
  "extra": {
    "expose": ["client/dist"]
  }
}
