{
  "name": "kooperativeweb/masha-feedly",
  "description": "Masha-Feedly-Einträge und Kommentare für Silverstripe CMS",
  "type": "silverstripe-vendormodule",
  "license": "MIT",
  "require": {
    "guzzlehttp/guzzle": "^7.9",
    "php": "^7.4 || ^8.0",
    "silverstripe/asset-admin": "^1.13",
    "silverstripe/cms": "^4.13",
    "unclecheese/display-logic": "^2.0",
    "symfony/polyfill-php80": "^1.25"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  },
  "autoload": {
    "files": [
      "src/Compatibility/SilverStripeLegacyValidationResult.php"
    ],
    "psr-4": {
      "KW\\MashaFeedly\\": "src/"
    }
  },
  "extra": {
    "expose": ["client/dist"]
  }
}
