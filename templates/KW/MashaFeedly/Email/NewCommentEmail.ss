<h1 style="margin:0 0 10px;color:#272331;font-family:Arial,sans-serif;font-size:24px;line-height:1.3"><%t KW\MashaFeedly\Translations.EMAIL_COMMENT_TITLE "Neuer Kommentar zu einer Masha:Feedly-Meldung" %></h1>
<% if $NotificationIntroHTML %>$NotificationIntroHTML.RAW<% else %><p style="margin:0 0 18px;color:#514b59;font-family:Arial,sans-serif;font-size:15px;line-height:1.6"><%t KW\MashaFeedly\Translations.EMAIL_COMMENT_INTRO "{author} hat einen Kommentar zu einer dir zugewiesenen Meldung auf {siteTitle} geschrieben." author=$CommentAuthor.XML siteTitle=$SiteTitle.XML %></p><% end_if %>
<div style="margin:18px 0;padding:18px 20px;border:1px solid #eee7ef;border-radius:12px;background:#fbf8fb;font-family:Arial,sans-serif;color:#272331">
    <p style="margin:0 0 10px;color:#514b59;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.04em"><%t KW\MashaFeedly\Translations.EMAIL_PREVIEW_ENTRY_DETAILS "Meldungsdetails" %></p>
    <table role="presentation" style="width:100%;border-collapse:collapse;font-size:14px;line-height:1.5"><tr><td style="width:34%;padding:8px 12px 8px 0;color:#6d6672;border-bottom:1px solid #eee7ef"><%t KW\MashaFeedly\Translations.EMAIL_ENTRY_LABEL "Meldung" %></td><td style="padding:8px 0;border-bottom:1px solid #eee7ef">$BugTitle.XML</td></tr><% if $ReporterName %><tr><td style="padding:8px 12px 8px 0;color:#6d6672;border-bottom:1px solid #eee7ef"><%t KW\MashaFeedly\Translations.EMAIL_NEW_REPORTER "Gemeldet von" %></td><td style="padding:8px 0;border-bottom:1px solid #eee7ef">$ReporterName.XML</td></tr><% end_if %><% if $CategoryTitle %><tr><td style="padding:8px 12px 8px 0;color:#6d6672;border-bottom:1px solid #eee7ef"><%t KW\MashaFeedly\Translations.EMAIL_NEW_CATEGORY "Kategorie" %></td><td style="padding:8px 0;border-bottom:1px solid #eee7ef">$CategoryTitle.XML</td></tr><% end_if %><% if $PriorityTitle %><tr><td style="padding:8px 12px 8px 0;color:#6d6672;border-bottom:1px solid #eee7ef"><%t KW\MashaFeedly\Translations.EMAIL_NEW_PRIORITY "Priorität" %></td><td style="padding:8px 0;border-bottom:1px solid #eee7ef">$PriorityTitle.XML</td></tr><% end_if %><% if $DueDate %><tr><td style="padding:8px 12px 8px 0;color:#6d6672;border-bottom:1px solid #eee7ef"><%t KW\MashaFeedly\Translations.EMAIL_NEW_DUE_DATE "Fällig am" %></td><td style="padding:8px 0;border-bottom:1px solid #eee7ef">$DueDate.XML</td></tr><% end_if %><tr><td style="padding:8px 12px 0 0;color:#6d6672"><%t KW\MashaFeedly\Translations.EMAIL_NEW_ASSIGNEES "Verantwortlich" %></td><td style="padding:8px 0"><% if $AssignedNames %>$AssignedNames.XML<% else %><%t KW\MashaFeedly\Translations.EMAIL_NEW_NO_ASSIGNEES "Noch niemand zugeordnet" %><% end_if %></td></tr></table>
</div>
<div style="margin:0 0 20px;padding:18px 20px;border:1px solid #eee7ef;border-radius:12px;background:#fbf8fb"><p style="margin:0 0 8px;color:#514b59;font-family:Arial,sans-serif;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.04em"><%t KW\MashaFeedly\Translations.EMAIL_PREVIEW_COMMENT_TITLE "Neuer Kommentar von {author}" author=$CommentAuthor.XML %></p><blockquote style="margin:0;padding:0 0 0 14px;border-left:3px solid #e6007e;color:#272331;font-family:Arial,sans-serif;font-size:15px;line-height:1.6;white-space:pre-wrap">$CommentText.XML</blockquote><% if $CommentDate %><p style="margin:10px 0 0;color:#6d6672;font-family:Arial,sans-serif;font-size:12px">$CommentDate.XML</p><% end_if %></div>
<p style="margin:22px 0"><a href="$EntryURL.XML" style="display:inline-block;padding:12px 18px;border-radius:9px;background:#e6007e;color:#fff;font-family:Arial,sans-serif;font-size:15px;font-weight:700;line-height:1.2;text-decoration:none"><%t KW\MashaFeedly\Translations.EMAIL_OPEN_COMMENT_ENTRY "Meldung und Kommentar in Masha:Feedly öffnen" %></a></p>
<% include KW/MashaFeedly/Email/EmailFooter %>
