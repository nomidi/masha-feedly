<h1 style="margin:0 0 10px;color:#272331;font-family:Arial,sans-serif;font-size:24px;line-height:1.3"><%t KW\MashaFeedly\Translations.EMAIL_NEW_TITLE "Neue Meldung" %></h1>
<p style="margin:0 0 18px;color:#514b59;font-family:Arial,sans-serif;font-size:15px;line-height:1.6"><%t KW\MashaFeedly\Translations.EMAIL_NEW_INTRO "Auf {siteTitle} wurde eine neue Meldung erstellt." siteTitle=$SiteTitle.XML %></p>
<table role="presentation" style="width:100%;margin:0 0 18px;border-collapse:collapse;color:#514b59;font-family:Arial,sans-serif;font-size:14px;line-height:1.5"><% if $ReporterName %><tr><td style="padding:4px 12px 4px 0;font-weight:700;white-space:nowrap"><%t KW\MashaFeedly\Translations.EMAIL_NEW_REPORTER "Gemeldet von" %></td><td style="padding:4px 0">$ReporterName.XML</td></tr><% end_if %><% if $CategoryTitle %><tr><td style="padding:4px 12px 4px 0;font-weight:700;white-space:nowrap"><%t KW\MashaFeedly\Translations.EMAIL_NEW_CATEGORY "Kategorie" %></td><td style="padding:4px 0">$CategoryTitle.XML</td></tr><% end_if %><% if $PriorityTitle %><tr><td style="padding:4px 12px 4px 0;font-weight:700;white-space:nowrap"><%t KW\MashaFeedly\Translations.EMAIL_NEW_PRIORITY "Priorität" %></td><td style="padding:4px 0">$PriorityTitle.XML</td></tr><% end_if %><% if $DueDate %><tr><td style="padding:4px 12px 4px 0;font-weight:700;white-space:nowrap"><%t KW\MashaFeedly\Translations.EMAIL_NEW_DUE_DATE "Fällig am" %></td><td style="padding:4px 0">$DueDate.XML</td></tr><% end_if %><tr><td style="padding:4px 12px 4px 0;font-weight:700;white-space:nowrap"><%t KW\MashaFeedly\Translations.EMAIL_NEW_ASSIGNEES "Verantwortlich" %></td><td style="padding:4px 0"><% if $AssignedNames %>$AssignedNames.XML<% else %><%t KW\MashaFeedly\Translations.EMAIL_NEW_NO_ASSIGNEES "Noch niemand zugeordnet" %><% end_if %></td></tr></table>
<div style="margin:0 0 20px;padding:16px 18px;border:1px solid #eee7ef;border-radius:10px;background:#fbf8fb"><strong style="display:block;margin:0 0 8px;color:#514b59;font-family:Arial,sans-serif;font-size:13px"><%t KW\MashaFeedly\Translations.EMAIL_NEW_DESCRIPTION_LABEL "Vollständige Beschreibung" %></strong><div style="color:#272331;font-family:Arial,sans-serif;font-size:15px;line-height:1.6;white-space:pre-wrap">$BugDescription.XML</div></div>
<p style="margin:22px 0"><a href="$EntryURL.XML" style="display:inline-block;padding:12px 18px;border-radius:9px;background:#e6007e;color:#fff;font-family:Arial,sans-serif;font-size:15px;font-weight:700;line-height:1.2;text-decoration:none"><%t KW\MashaFeedly\Translations.EMAIL_OPEN_ENTRY "Meldung ansehen" %></a></p>
<% include KW/MashaFeedly/Email/EmailFooter %>
