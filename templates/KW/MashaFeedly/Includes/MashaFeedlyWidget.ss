<div class="kw-masha-feedly" data-kw-masha-feedly data-theme="$Theme" data-font-size="$FontSize" data-address="$Address" data-list-url="$ListEntriesURL" data-mark-entry-read-url="$MarkEntryReadURL" data-saved-views-url="$SavedViewsURL" data-save-view-url="$SaveViewURL" data-delete-view-url="$DeleteViewURL" data-onboarding-enabled="$OnboardingEnabled" data-onboarding-url="$CompleteOnboardingURL" data-onboarding-restart-url="$RestartOnboardingURL" data-security-id="$TokenValue" data-estimate-hourly-rate="$EstimateHourlyRate" data-can-manage-estimate="<% if $CanManageEstimate %>1<% else %>0<% end_if %>" data-can-approve-estimate="<% if $CanApproveEstimate %>1<% else %>0<% end_if %>" data-unicorn-url="$resourceURL('kooperativeweb/masha-feedly:client/dist/icons/masha-feedly-unicorn.svg')">
    <button class="kw-masha-feedly__toggle" type="button" aria-expanded="false" aria-controls="kw-masha-feedly-panel" aria-label="<%t KW\MashaFeedly\Translations.OPEN_WIDGET 'Masha:Feedly öffnen' %>">
        <img class="kw-masha-feedly__logo" src="$resourceURL('kooperativeweb/masha-feedly:client/dist/icons/masha-feedly.svg')" alt="">
    </button>
    <section class="kw-masha-feedly__panel" id="kw-masha-feedly-panel" aria-label="<%t KW\MashaFeedly\Translations.MODULE_NAME 'Masha:Feedly' %>" hidden>
        <header class="kw-masha-feedly__header">
