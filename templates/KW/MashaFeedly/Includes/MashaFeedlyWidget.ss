                    <button class="kw-masha-feedly__estimate-queue-button kw-masha-feedly__estimate-queue-button--approved" type="button" data-masha-feedly-open-estimate-approved data-tooltip="<%t KW\MashaFeedly\Translations.OPEN_ESTIMATE_APPROVED 'Freigegebene Kostenschätzungen anzeigen, die noch nicht weiterbearbeitet wurden' %>" aria-label="<%t KW\MashaFeedly\Translations.OPEN_ESTIMATE_APPROVED 'Freigegebene Kostenschätzungen anzeigen, die noch nicht weiterbearbeitet wurden' %>" hidden><svg viewBox="0 0 512.12 512.12" aria-hidden="true" focusable="false"><path d="m256.038 91.06c-90.981 0-165 74.019-165 165s74.019 165 165 165 165-74.019 165-165-74.018-165-165-165zm0 300c-74.439 0-135-60.561-135-135s60.561-135 135-135 135 60.561 135 135-60.56 135-135 135z"/><path d="m320.432 200.453-79.394 79.393-49.394-49.393c-5.857-5.858-15.355-5.858-21.213 0s-5.858 15.355 0 21.213l60 60c2.929 2.929 6.768 4.394 10.606 4.394s7.678-1.464 10.606-4.394l90-90c5.858-5.858 5.858-15.355 0-21.213-5.856-5.858-15.354-5.858-21.211 0z"/><path d="m490.641 150.89c-.05-.031-52.39-31.361-52.39-31.361l-11.749-48.658c-5.213-21.591-25.066-36.022-47.215-34.304l-59.644 4.616s-34.357-30.322-34.425-30.379c-16.908-14.402-41.453-14.402-58.361 0-.067.057-34.425 30.379-34.425 30.379l-59.644-4.616c-21.971-1.706-41.672 12.473-47.082 33.766l-16.356 52.116s-47.807 28.402-47.87 28.441c-18.923 11.63-26.508 34.973-18.034 55.505l20.408 49.455-20.408 49.454c-8.474 20.532-.889 43.875 18.035 55.505.058.036 52.296 31.162 52.296 31.162l11.798 48.857c4.932 20.429 22.97 34.444 43.656 34.442 3.164 0-.39.12 62.582-4.706 0 0 34.989 30.704 35.045 30.751 8.454 7.201 18.817 10.802 29.181 10.802 10.363 0 20.727-3.601 29.181-10.802.056-.048 35.045-30.751 35.045-30.751l59.023 4.568c22.142 1.711 42.003-12.713 47.215-34.304l11.749-48.659c64.047-38.338 50.467-30.174 52.39-31.361 18.922-11.63 26.507-34.973 18.033-55.505l-20.408-49.455 20.408-49.455c8.473-20.53.889-43.872-18.034-55.503zm-32.468 110.682 22.77 55.177c2.816 6.822.313 14.5