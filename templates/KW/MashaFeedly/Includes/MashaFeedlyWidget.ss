            <button class="kw-masha-feedly__close" type="button" aria-label="<%t KW\MashaFeedly\Translations.CLOSE_WIDGET 'Masha:Feedly schließen' %>">×</button>
        </header>
        <div class="kw-masha-feedly__content">
