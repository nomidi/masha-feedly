                    <% end_if %>
                    <button class="kw-masha-feedly__closed-button" type="button" data-masha-feedly-open-closed data-has-closed="false" hidden aria-label="<%t KW\MashaFeedly\Translations.OPEN_CLOSED_ENTRIES 'Abgeschlossene Einträge ansehen' %>" data-tooltip="<%t KW\MashaFeedly\Translations.OPEN_CLOSED_ENTRIES 'Abgeschlossene Einträge ansehen' %>"><svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="m9.55 17.3-4.2-4.2 1.4-1.4 2.8 2.8 7.7-7.7 1.4 1.4z"/></svg><strong data-masha-feedly-closed-count>0</strong><span class="kw-masha-feedly__sr-only"><%t KW\MashaFeedly\Translations.CLOSED_ENTRIES_BUTTON 'abgeschlossene Einträge' %></span></button>
                </div>
                <button class="kw-masha-feedly__rainbow" type="button" data-masha-feedly-rainbow aria-label="<%t KW\MashaFeedly\Translations.RAINBOW_PAGE_TITLE 'Auf dieser Seite keine Fehler' %>" hidden>
                    <svg class="kw-masha-feedly__rainbow-icon" role="img" aria-label="<%t KW\MashaFeedly\Translations.RAINBOW_ICON_DESCRIPTION 'Regenbogen-Bug als Zeichen für eine fehlerfreie Seite' %>" viewBox="0 0 32 32"><defs><linearGradient id="kw-masha-feedly-bug-gradient" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff3e8d"/><stop offset=".28" stop-color="#ff9f1c"/><stop offset=".52" stop-color="#f4cf32"/><stop offset=".72" stop-color="#32c985"/><stop offset="1" stop-color="#7655e8"/></linearGradient></defs><path fill="url(#kw-masha-feedly-bug-gradient)" d="m29 18h-3.023a12.684 12.684 0 0 0 -1.008-4.444l2.586-1.724a1 1 0 1 0 -1.11-1.664l-2.424 1.616c-.124-.191-.248-.383-.383-.566a3.021 3.021 0 0 0 -1.644-1.1c0-.042.006-.081.006-.123a5.986 5.986 0 0 0 -2.1-4.55l1-2a1 1 0 1 0 -1.79-.894l-.93 1.861a5.92 5.92 0 0 0 -4.35 0l-.93-1.859a1 1 0 0 0 -1.79.894l1 2a5.986 5.986 0 0 0 -2.11 4.553c0 .042.005.081.006.123a3.021 3.021 0 0 0 -1.644 1.1c-.135.183-.259.375-.383.566l-2.424-1.621a1 1 0 0 0 -1.11 1.664l2.586 1.724a12.684 12.684 0 0 0 -1.008 4.444h-3.023a1 1 0 0 0 0 2h3.086a12.54 12.54 0 0 0 .932 3.568l-2.725 2.725a1 1 0 1 0 1.414 1.414l2.3-2.3a9.635 9.635 0 0 0 7.993 4.593 9.635 9.635 0 0 0 8-4.591l2.3 2.3a1 1 0 0 0 1.414-1.414l-2.725-2.725a12.54 12.54 0 0 0 .925-3.57h3.086a1 1 0 0 0 0-2zm-13-12a4 4 0 0 1 4 4h-8a4 4 0 0 1 4-4zm-8 12.579a10.414 10.414 0 0 1 1.969-6.171 1.1 1.1 0 0 1 .878-.408h4.153v15.918c-3.94-.582-7-4.544-7-9.339zm9 9.339v-15.918h4.153a1.1 1.1 0 0 1 .878.408 10.414 10.414 0 0 1 1.969 6.171c0 4.795-3.06 8.757-7 9.339z"/></svg>
                    <span class="kw-masha-feedly__rainbow-copy" data-masha-feedly-rainbow-copy hidden><strong data-masha-feedly-rainbow-title><%t KW\MashaFeedly\Translations.RAINBOW_PAGE_TITLE 'Auf dieser Seite keine Fehler' %></strong><span data-masha-feedly-rainbow-message></span></span>
                </button>
                <button class="kw-masha-feedly__help-button" type="button" data-masha-feedly-open-help aria-label="<%t KW\MashaFeedly\Translations.OPEN_HELP 'Hilfe zu Masha:Feedly' %>">?</button>
            </section>
        </div>
    </section>
    <div class="kw-masha-feedly__selection-banner" data-masha-feedly-selection-banner hidden>
        <% if $Address == 'sie' %><span data-masha-feedly-selection-message><%t KW\MashaFeedly\Translations.SELECT_AREA_SIE 'Bitte wählen Sie den betroffenen Bereich auf der Seite aus.' %></span><% else %><span data-masha-feedly-selection-message><%t KW\MashaFeedly\Translations.SELECT_AREA_DU 'Wähle den betroffenen Bereich auf der Seite aus.' %></span><% end_if %>
        <button type="button" data-masha-feedly-cancel-selection><%t KW\MashaFeedly\Translations.ENTRY_CANCEL 'Abbrechen' %></button>
    </div>
    <div class="kw-masha-feedly__modal kw-masha-feedly__onboarding-modal" data-masha-feedly-onboarding-welcome hidden>
        <section class="kw-masha-feedly__dialog" role="dialog" aria-modal="true" aria-labelledby="kw-masha-feedly-onboarding-title">
            <header class="kw-masha-feedly__dialog-header kw-masha-feedly__onboarding-welcome-header"><img class="kw-masha-feedly__onboarding-logo kw-masha-feedly__onboarding-logo--welcome" src="$resourceURL('kooperativeweb/masha-feedly:client/dist/icons/masha-feedly.svg')" alt="" aria-hidden="true"><div><span class="kw-masha-feedly__eyebrow"><%t KW\MashaFeedly\Translations.TOUR_WELCOME_EYEBROW 'DEIN ERSTER SCHRITT' %></span><h2 id="kw-masha-feedly-onboarding-title"><%t KW\MashaFeedly\Translations.TOUR_WELCOME_TITLE 'Willkommen bei Masha:Feedly' %></h2></div></header>
            <p class="kw-masha-feedly__onboarding-copy"><%t KW\MashaFeedly\Translations.TOUR_WELCOME_TEXT 'Wenn dir ein Fehler auffällt, kannst du ihn direkt auf der Website melden. Die kurze Einführung zeigt dir, wie es geht.' %></p>
            <footer class="kw-masha-feedly__dialog-actions"><button type="button" class="kw-masha-feedly__secondary" data-masha-feedly-tour-skip><%t KW\MashaFeedly\Translations.TOUR_SKIP 'Später' %></button><button type="button" class="kw-masha-feedly__submit" data-masha-feedly-tour-start><%t KW\MashaFeedly\Translations.TOUR_START 'Einführung starten' %></button></footer>
        </section>
    </div>
    <div class="kw-masha-feedly__modal kw-masha-feedly__onboarding-modal" data-masha-feedly-onboarding-thanks hidden>
        <section class="kw-masha-feedly__dialog" role="dialog" aria-modal="true" aria-labelledby="kw-masha-feedly-thanks-title">
            <header class="kw-masha-feedly__dialog-header"><img class="kw-masha-feedly__onboarding-logo" src="$resourceURL('kooperativeweb/masha-feedly:client/dist/icons/masha-feedly.svg')" alt="" aria-hidden="true"><div><span class="kw-masha-feedly__eyebrow"><%t KW\MashaFeedly\Translations.TOUR_WELCOME_EYEBROW 'DEIN ERSTER SCHRITT' %></span><h2 id="kw-masha-feedly-thanks-title"><%t KW\MashaFeedly\Translations.TOUR_THANKS_TITLE 'Danke fürs Mitmachen!' %></h2></div></header>
            <p class="kw-masha-feedly__onboarding-copy"><%t KW\MashaFeedly\Translations.TOUR_THANKS_TEXT 'Du hast deine erste Meldung erstellt und gelernt, wie du Einträge ansiehst und bearbeitest. In deinem Profil kannst du dein Feedly-Icon und deine Avatarfarbe anpassen sowie E-Mail-Benachrichtigungen zu Kommentaren einrichten.' %></p>
            <footer class="kw-masha-feedly__dialog-actions"><a class="kw-masha-feedly__submit" data-masha-feedly-profile-link href="$ProfileURL"><%t KW\MashaFeedly\Translations.TOUR_PROFILE_LINK 'Profileinstellungen öffnen' %> →</a><button type="button" class="kw-masha-feedly__secondary" data-masha-feedly-thanks-close><%t KW\MashaFeedly\Translations.TOUR_DONE 'Fertig' %></button></footer>
        </section>
    </div>
    <aside class="kw-masha-feedly__onboarding-tip" data-masha-feedly-onboarding-tip hidden role="status" aria-live="polite">
        <p data-masha-feedly-onboarding-text></p>
        <small class="kw-masha-feedly__onboarding-escape-hint" data-masha-feedly-onboarding-escape-hint><%t KW\MashaFeedly\Translations.TOUR_ESCAPE_HINT 'Tipp: Esc beendet die Einführung jederzeit.' %></small>
        <button type="button" data-masha-feedly-tour-cancel><%t KW\MashaFeedly\Translations.TOUR_CANCEL 'Einführung abbrechen' %></button>
    </aside>
    <div class="kw-masha-feedly__modal kw-masha-feedly__help-modal" data-masha-feedly-help-modal hidden>
        <section class="kw-masha-feedly__dialog" role="dialog" aria-modal="true" aria-labelledby="kw-masha-feedly-help-title">
            <header class="kw-masha-feedly__dialog-header"><div><span class="kw-masha-feedly__eyebrow"><%t KW\MashaFeedly\Translations.HELP_SHORT 'KURZ ERKLÄRT' %></span><h2 id="kw-masha-feedly-help-title" data-masha-feedly-help-heading tabindex="-1"><%t KW\MashaFeedly\Translations.HELP_TITLE 'Masha:Feedly verwenden' %></h2></div><button type="button" class="kw-masha-feedly__close" data-masha-feedly-close-help aria-label="<%t KW\MashaFeedly\Translations.HELP_CLOSE 'Hilfe schließen' %>">×</button></header>
            <div class="kw-masha-feedly__help-content">
                <h3><%t KW\MashaFeedly\Translations.HELP_CREATE_TITLE 'Einträge erstellen' %></h3><p><% if $Address == 'sie' %><%t KW\MashaFeedly\Translations.HELP_CREATE_SIE 'Mit + starten Sie die Bereichsauswahl. Klicken Sie anschließend auf die betroffene Stelle der Webseite und beschreiben Sie den Fehler oder Hinweis. Status, Datum und verantwortliche Personen legen Sie direkt im Formular fest.' %><% else %><%t KW\MashaFeedly\Translations.HELP_CREATE_DU 'Mit + startest du die Bereichsauswahl. Klicke anschließend auf die betroffene Stelle der Webseite und beschreibe den Fehler oder Hinweis. Status, Datum und verantwortliche Personen kannst du direkt im Formular festlegen.' %><% end_if %></p>
                <h3><%t KW\MashaFeedly\Translations.HELP_FIND_TITLE 'Einträge finden' %></h3><p><% if $Address == 'sie' %><%t KW\MashaFeedly\Translations.HELP_FIND_SIE 'Der Globus zeigt offene Fehler auf der gesamten Website. Das Seitensymbol zeigt offene Fehler auf der Seite, die Sie gerade ansehen. Klicken Sie auf einen Zähler, um die passende Liste zu öffnen. Dort können Sie nach Seite, persönlicher Zuständigkeit und Kategorie filtern.' %><% else %><%t KW\MashaFeedly\Translations.HELP_FIND_DU 'Der Globus zeigt offene Fehler auf der gesamten Website. Das Seitensymbol zeigt offene Fehler auf der Seite, die du gerade ansiehst. Tippe auf einen Zähler, um die passende Liste zu öffnen. Dort kannst du nach Seite, persönlicher Zuständigkeit und Kategorie filtern.' %><% end_if %></p>
                <h3><%t KW\MashaFeedly\Translations.HELP_EDIT_TITLE 'Einträge bearbeiten' %></h3><p><% if $Address == 'sie' %><%t KW\MashaFeedly\Translations.HELP_EDIT_SIE 'Die nummerierten Standort-Symbole markieren Einträge auf der Seite. Wählen Sie einen Eintrag in der Übersicht, um Beschreibung und Seitenkontext zu lesen. Status und Zuständigkeiten können Sie anpassen; über den Seitenlink springen Sie zur betroffenen Stelle.' %><% else %><%t KW\MashaFeedly\Translations.HELP_EDIT_DU 'Die nummerierten Standort-Symbole markieren Einträge auf der Seite. Wähle einen Eintrag in der Übersicht, um Beschreibung und Seitenkontext zu lesen. Status und Zuständigkeiten kannst du anpassen; über den Seitenlink springst du zur betroffenen Stelle.' %><% end_if %></p>
                <h3><%t KW\MashaFeedly\Translations.HELP_PROFILE_TITLE 'Neuigkeiten und Profil' %></h3><p><% if $Address == 'sie' %><%t KW\MashaFeedly\Translations.HELP_PROFILE_SIE 'Neue oder geänderte Einträge werden pro Person als ungelesen markiert. Ihr Profilbild, Ihre Farbe und Ihre E-Mail-Benachrichtigungen verwalten Sie im Masha:Feedly-Bereich Ihres Profils.' %><% else %><%t KW\MashaFeedly\Translations.HELP_PROFILE_DU 'Neue oder geänderte Einträge werden pro Person als ungelesen markiert. Dein Profilbild, deine Farbe und deine E-Mail-Benachrichtigungen verwaltest du im Masha:Feedly-Bereich deines Profils.' %><% end_if %></p>
                <p class="kw-masha-feedly__help-restart"><% if $Address == 'sie' %>Möchten Sie die Schritte noch einmal durchgehen? <% else %>Möchtest du die Schritte noch einmal durchgehen? <% end_if %><button type="button" class="kw-masha-feedly__help-link" data-masha-feedly-restart-onboarding><%t KW\MashaFeedly\Translations.TOUR_RESTART 'Einführung erneut starten' %> →</button><span data-masha-feedly-restart-status role="status" aria-live="polite"></span></p>
            </div>
        </section>
    </div>
    <div class="kw-masha-feedly__toast" data-masha-feedly-save-toast role="status" aria-live="polite" hidden>
        <span class="kw-masha-feedly__toast-icon" aria-hidden="true">✓</span>
        <span data-masha-feedly-save-message></span>
        <button type="button" data-masha-feedly-dismiss-toast aria-label="<%t KW\MashaFeedly\Translations.SAVE_CLOSE_TOAST 'Meldung schließen' %>">×</button>
    </div>
    <div class="kw-masha-feedly__modal kw-masha-feedly__entries-modal" data-masha-feedly-entries-modal hidden>
        <section class="kw-masha-feedly__dialog kw-masha-feedly__entries-dialog" role="dialog" aria-modal="true" aria-labelledby="kw-masha-feedly-entries-title">
            <header class="kw-masha-feedly__dialog-header">
                <div><span class="kw-masha-feedly__eyebrow"><%t KW\MashaFeedly\Translations.LIST_BRAND 'Masha:Feedly' %></span><h2 id="kw-masha-feedly-entries-title" data-masha-feedly-list-heading tabindex="-1"><%t KW\MashaFeedly\Translations.LIST_TITLE 'Alle Einträge' %></h2></div>
                <button type="button" class="kw-masha-feedly__close" data-masha-feedly-close-list aria-label="<%t KW\MashaFeedly\Translations.HELP_CLOSE_LIST 'Übersicht schließen' %>">×</button>
            </header>
            <div class="kw-masha-feedly__list-controls">
            <details class="kw-masha-feedly__filters-details" data-masha-feedly-filters-details>
                <summary><svg class="kw-masha-feedly__filter-summary-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.25A1.25 1.25 0 0 1 4.25 4h15.5a1.25 1.25 0 0 1 .95 2.06L14 13.75v5a1.25 1.25 0 0 1-1.82 1.12l-2.5-1.25A1.25 1.25 0 0 1 9 17.5v-3.75L3.3 6.06A1.25 1.25 0 0 1 3 5.25Z"/></svg><span><%t KW\MashaFeedly\Translations.FILTERS_TITLE 'Filter' %></span><strong data-masha-feedly-filter-count>0</strong><small data-masha-feedly-filter-state><%t KW\MashaFeedly\Translations.FILTERS_NONE 'Keine aktiv' %></small></summary>
                <div class="kw-masha-feedly__entries-toolbar">
                    <label><span class="kw-masha-feedly__filter-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v2H4zm3 6h10v2H7zm3 6h4v2h-4z"/></svg><%t KW\MashaFeedly\Translations.FILTER_MODE 'Einträge anzeigen' %></span><select data-masha-feedly-list-mode><option value="unread"><% if $Address == 'sie' %><%t KW\MashaFeedly\Translations.NEWS_BUTTON_SIE 'Neu seit Ihrem letzten Besuch' %><% else %><%t KW\MashaFeedly\Translations.NEWS_BUTTON_DU 'Neu seit deinem letzten Besuch' %><% end_if %></option><option value="open"><%t KW\MashaFeedly\Translations.FILTER_OPEN 'Offene Einträge' %></option><option value="page-open"><%t KW\MashaFeedly\Translations.FILTER_PAGE_OPEN 'Offene Fehler auf dieser Seite' %></option><option value="feedback"><%t KW\MashaFeedly\Translations.FEEDBACK_BUTTON 'Wartet auf Feedback' %></option><% if $CanApproveEstimate %><option value="estimate-pending"><%t KW\MashaFeedly\Translations.ESTIMATE_PENDING_BUTTON 'Wartet auf Freigabe' %></option><option value="estimate-approved"><%t KW\MashaFeedly\Translations.ESTIMATE_APPROVED_BUTTON 'Kostenschätzung freigegeben' %></option><% end_if %><option value="closed"><%t KW\MashaFeedly\Translations.FILTER_CLOSED 'Abgeschlossene Einträge' %></option><option value="all"><%t KW\MashaFeedly\Translations.FILTER_ALL 'Alle Einträge' %></option><option value="page"><%t KW\MashaFeedly\Translations.FILTER_PAGE 'Alle Einträge auf dieser Seite' %></option><option value="mine"><%t KW\MashaFeedly\Translations.FILTER_MINE 'Für mich' %></option></select></label>
                    <label><span class="kw-masha-feedly__filter-label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4.75A1.75 1.75 0 0 1 5.75 3h4.1c.46 0 .9.18 1.23.51l1.4 1.4c.14.14.33.22.53.22h5.24A1.75 1.75 0 0 1 20 6.88v10.37A1.75 1.75 0 0 1 18.25 19h-12.5A1.75 1.75 0 0 1 4 17.25zm2 1v11.5h12V7.13h-5.23a2.75 2.75 0 0 1-1.94-.8l-1.4-1.4a.33.33 0 0 0-.24-.1z"/></svg><%t KW\MashaFeedly\Translations.FILTER_CATEGORY 'Kategorie' %></span><select data-masha-feedly-category-filter><option value=""><%t KW\MashaFeedly\Translations.FILTER_ALL_CATEGORIES 'Alle Kategorien' %></option></select></label>
                    <label><span class="kw-masha-feedly__filter-label"><span class="kw-masha-feedly__priority-filter-icon" data-masha-feedly-priority-filter-icon aria-hidden="true"></span><%t KW\MashaFeedly\Translations.FILTER_PRIORITY 'Priorität' %></span><select data-masha-feedly-priority-filter><option value=""><%t KW\MashaFeedly\Translations.FILTER_ALL_PRIORITIES 'Alle Prioritäten' %></option></select></label>
                </div>
                <div class="kw-masha-feedly__saved-view-select">
                    <label><%t KW\MashaFeedly\Translations.SAVED_VIEW_SELECT 'Gespeicherte Ansicht' %><select data-masha-feedly-saved-view><option value=""><%t KW\MashaFeedly\Translations.SAVED_VIEW_NONE 'Ansicht auswählen …' %></option></select></label>
                </div>
                <details class="kw-masha-feedly__saved-views-details">
                    <summary><%t KW\MashaFeedly\Translations.SAVED_VIEW_DETAILS 'Filterkombination speichern und verwalten' %></summary>
                    <div class="kw-masha-feedly__saved-views" data-masha-feedly-saved-views>
                    <label><%t KW\MashaFeedly\Translations.SAVED_VIEW_NAME 'Name für aktuelle Filter' %><input type="text" maxlength="60" data-masha-feedly-saved-view-name placeholder="<%t KW\MashaFeedly\Translations.SAVED_VIEW_EXAMPLE 'z. B. Meine offenen kritischen Fehler' %>"></label>
                    <button type="button" class="kw-masha-feedly__secondary" data-masha-feedly-save-view><%t KW\MashaFeedly\Translations.SAVED_VIEW_SAVE 'Ansicht speichern' %></button>
                    <button type="button" class="kw-masha-feedly__secondary" data-masha-feedly-delete-view disabled><%t KW\MashaFeedly\Translations.SAVED_VIEW_DELETE 'Ausgewählte Ansicht löschen' %></button>
                    <span data-masha-feedly-saved-view-status role="status" aria-live="polite"></span>
                    </div>
                </details>
            </details>
            <details class="kw-masha-feedly__sort-details" data-masha-feedly-sort-details>
                <summary aria-label="<%t KW\MashaFeedly\Translations.SORTING_TITLE 'Sortierung' %>" title="<%t KW\MashaFeedly\Translations.SORTING_TITLE 'Sortierung' %>"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16v2H4zm3 6h10v2H7zm3 6h4v2h-4z"/><path d="M18 3v5m0 0 2-2m-2 2-2-2"/></svg><span class="kw-masha-feedly__sort-current" data-masha-feedly-sort-current aria-hidden="true">↑</span><span class="kw-masha-feedly__sr-only" data-masha-feedly-sort-label><%t KW\MashaFeedly\Translations.SORTING_TITLE 'Sortierung' %></span></summary>
                <div class="kw-masha-feedly__sort-popover" role="group" aria-label="<%t KW\MashaFeedly\Translations.SORTING_TITLE 'Sortierung' %>">
                    <button type="button" data-masha-feedly-sort-option="due"><span><%t KW\MashaFeedly\Translations.SORT_DUE 'Fälligkeit' %></span><span data-sort-direction aria-hidden="true"></span></button>
                    <button type="button" data-masha-feedly-sort-option="created"><span><%t KW\MashaFeedly\Translations.SORT_CREATED 'Erstellt am' %></span><span data-sort-direction aria-hidden="true"></span></button>
                    <button type="button" data-masha-feedly-sort-option="priority"><span><%t KW\MashaFeedly\Translations.SORT_PRIORITY 'Priorität' %></span><span data-sort-direction aria-hidden="true"></span></button>
                    <button type="button" data-masha-feedly-sort-option="assignee"><span><%t KW\MashaFeedly\Translations.SORT_ASSIGNEE 'Zuständigkeit' %></span><span data-sort-direction aria-hidden="true"></span></button>
                    <button type="button" data-masha-feedly-sort-option="activity"><span><%t KW\MashaFeedly\Translations.SORT_ACTIVITY 'Letzte Aktivität' %></span><span data-sort-direction aria-hidden="true"></span></button>
                </div>
            </details>
            </div>
            <div class="kw-masha-feedly__active-filters" data-masha-feedly-active-filters role="status" aria-live="polite" hidden></div>
            <p class="kw-masha-feedly__entries-count" data-masha-feedly-list-count role="status" aria-live="polite" aria-atomic="true"></p>
            <div class="kw-masha-feedly__entries-list" data-masha-feedly-entries-list aria-live="polite"></div>
        </section>
    </div>
    <div class="kw-masha-feedly__modal kw-masha-feedly__create-modal" data-masha-feedly-modal hidden>
        <div class="kw-masha-feedly__dialog" role="dialog" aria-modal="true" aria-labelledby="kw-masha-feedly-dialog-title">
            <header class="kw-masha-feedly__dialog-header">
                <div><span class="kw-masha-feedly__eyebrow"><%t KW\MashaFeedly\Translations.NEW_ENTRY_EYEBROW 'NEUER EINTRAG' %></span><h2 id="kw-masha-feedly-dialog-title" tabindex="-1"><% if $Address == 'sie' %><%t KW\MashaFeedly\Translations.NEW_ENTRY_TITLE_SIE 'Was ist Ihnen aufgefallen?' %><% else %><%t KW\MashaFeedly\Translations.NEW_ENTRY_TITLE_DU 'Was ist dir aufgefallen?' %><% end_if %></h2></div>
                <button type="button" class="kw-masha-feedly__close" data-masha-feedly-close-modal aria-label="<%t KW\MashaFeedly\Translations.DIALOG_CLOSE 'Dialog schließen' %>">×</button>
            </header>
            <form id="kw-masha-feedly-create-form" data-masha-feedly-entry-form data-create-url="$CreateEntryURL" data-list-url="$ListEntriesURL" data-security-id="$TokenValue">
                <div class="kw-masha-feedly__selected-context" data-masha-feedly-selected-context></div>
                <label><%t KW\MashaFeedly\Translations.ENTRY_DESCRIPTION_LABEL 'Beschreibung' %><textarea name="Content" rows="5" required placeholder="<% if $Address == 'sie' %><%t KW\MashaFeedly\Translations.ENTRY_DESCRIPTION_PLACEHOLDER_SIE 'Beschreiben Sie den Fehler oder Hinweis …' %><% else %><%t KW\MashaFeedly\Translations.ENTRY_DESCRIPTION_PLACEHOLDER_DU 'Beschreibe den Fehler oder Hinweis …' %><% end_if %>"></textarea></label>
                <label class="kw-masha-feedly__attachment-field">
                    <svg class="kw-masha-feedly__upload-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22,13a1,1,0,0,0-1,1v4.213A2.79,2.79,0,0,1,18.213,21H5.787A2.79,2.79,0,0,1,3,18.213V14a1,1,0,0,0-2,0v4.213A4.792,4.792,0,0,0,5.787,23H18.213A4.792,4.792,0,0,0,23,18.213V14A1,1,0,0,0,22,13Z"/><path d="M6.707,8.707,11,4.414V17a1,1,0,0,0,2,0V4.414l4.293,4.293a1,1,0,0,0,1.414-1.414l-6-6a1,1,0,0,0-1.414,0l-6,6A1,1,0,0,0,6.707,8.707Z"/></svg>
                    <span class="kw-masha-feedly__attachment-title">Dateien anhängen</span>
                    <span class="kw-masha-feedly__attachment-hint">Bilder, PDFs oder ZIP-Dateien auswählen</span>
                    <input type="file" name="Attachments[]" aria-label="Dateien auswählen" multiple accept="image/jpeg,image/png,image/gif,image/webp,application/pdf,application/zip,.jpg,.jpeg,.png,.gif,.webp,.pdf,.zip">
                    <small>Maximal 10 MB pro Datei, 20 MB insgesamt</small>
                </label>
                <div class="kw-masha-feedly__form-grid">
                    <label><%t KW\MashaFeedly\Translations.STATUS_LABEL 'Status' %><select name="CategoryID" data-masha-feedly-create-category><% loop $Categories %><% if $CanSelectForNewEntry %><option value="$ID" data-system-key="$SystemKey">$Title</option><% end_if %><% end_loop %></select></label>
                    <label><%t KW\MashaFeedly\Translations.FIELD_PRIORITY 'Priorität' %><select name="PriorityID"><% loop $Priorities %><option value="$ID" <% if $IsDefault %>selected<% end_if %>>$Title</option><% end_loop %></select></label>
                    <label><%t KW\MashaFeedly\Translations.FIELD_DUE_DATE 'Fällig am' %><input name="DueDate" type="date"></label>
                </div>
                <% if $CanManageEstimate %>
                <section class="kw-masha-feedly__estimate" data-masha-feedly-create-estimate hidden aria-live="polite">
                    <div class="kw-masha-feedly__estimate-heading"><span aria-hidden="true">€</span><div><strong><%t KW\MashaFeedly\Translations.ESTIMATE_TITLE 'Kostenschätzung' %></strong><small><%t KW\MashaFeedly\Translations.ESTIMATE_RATE_HINT 'Preis automatisch mit dem Stundensatz berechnet' %></small></div></div>
                    <div class="kw-masha-feedly__estimate-fields"><label><%t KW\MashaFeedly\Translations.ESTIMATE_DURATION 'Geschätzte Dauer' %><input name="EstimatedCostDuration" type="text" maxlength="80" placeholder="10 Minuten oder 2–4 Stunden" disabled></label><output class="kw-masha-feedly__estimate-price" data-masha-feedly-estimate-price></output><label class="kw-masha-feedly__estimate-note"><%t KW\MashaFeedly\Translations.ESTIMATE_NOTE 'Erläuterung' %><textarea name="EstimatedCostNote" rows="2" maxlength="2000" disabled></textarea></label></div>
                </section>
                <% end_if %>
                <% if $Members %>
                    <fieldset class="kw-masha-feedly__assignees"><legend><%t KW\MashaFeedly\Translations.ASSIGNEES_LABEL 'Verantwortlich' %></legend><div><% loop $Members %><label class="kw-masha-feedly__assignee-choice" title="$Name"><input type="checkbox" name="AssignedMemberIDs[]" value="$ID"><span class="kw-masha-feedly__assignee-avatar" style="background-color: $Color" aria-label="$Name"><% if $ImageURL %><img src="$ImageURL" alt=""><% else %>$Initials<% end_if %></span><span class="kw-masha-feedly__assignee-name">$Name</span></label><% end_loop %></div></fieldset>
                <% end_if %>
                <p class="kw-masha-feedly__form-status" data-masha-feedly-form-status role="status" aria-live="polite" aria-atomic="true"></p>
            </form>
            <footer class="kw-masha-feedly__dialog-actions"><button type="button" class="kw-masha-feedly__secondary" data-masha-feedly-close-modal><%t KW\MashaFeedly\Translations.ENTRY_CANCEL 'Abbrechen' %></button><button type="submit" form="kw-masha-feedly-create-form" class="kw-masha-feedly__submit"><%t KW\MashaFeedly\Translations.ENTRY_SAVE 'Eintrag speichern' %> <span aria-hidden="true">→</span></button></footer>
        </div>
    </div>
    <div class="kw-masha-feedly__modal kw-masha-feedly__edit-modal" data-masha-feedly-edit-modal hidden>
        <section class="kw-masha-feedly__dialog kw-masha-feedly__edit-dialog" role="dialog" aria-modal="true" aria-labelledby="kw-masha-feedly-edit-title">
            <header class="kw-masha-feedly__dialog-header"><div><span class="kw-masha-feedly__eyebrow"><%t KW\MashaFeedly\Translations.EDIT_EYEBROW 'EINTRAG BEARBEITEN' %></span><h2 id="kw-masha-feedly-edit-title" data-masha-feedly-edit-heading tabindex="-1"><%t KW\MashaFeedly\Translations.EDIT_ENTRY_FALLBACK 'Eintrag' %></h2><div class="kw-masha-feedly__entry-created" data-masha-feedly-entry-created aria-live="polite"><span class="kw-masha-feedly__entry-created-avatar" data-masha-feedly-entry-created-avatar aria-hidden="true"></span><span class="kw-masha-feedly__entry-created-copy"><span class="kw-masha-feedly__entry-created-by" data-masha-feedly-entry-created-by></span><time class="kw-masha-feedly__entry-created-at" data-masha-feedly-entry-created-at></time></span></div></div><div class="kw-masha-feedly__edit-header-actions"><span class="kw-masha-feedly__edit-priority" data-masha-feedly-edit-priority role="img" aria-label="Priorität" hidden></span><button type="button" class="kw-masha-feedly__entry-share" data-masha-feedly-share-active-entry aria-label="<%t KW\MashaFeedly\Translations.ENTRY_SHARE_ARIA_DEFAULT 'Link zu diesem Eintrag teilen' %>" title="<%t KW\MashaFeedly\Translations.ENTRY_SHARE_ARIA_DEFAULT 'Link zu diesem Eintrag teilen' %>"><svg viewBox="-33 0 512 512" aria-hidden="true" focusable="false"><path d="m361.824219 344.394531c-24.53125 0-46.632813 10.59375-61.972657 27.445313l-137.972656-85.453125c3.683594-9.429688 5.726563-19.671875 5.726563-30.386719 0-10.71875-2.042969-20.960938-5.726563-30.386719l137.972656-85.457031c15.339844 16.851562 37.441407 27.449219 61.972657 27.449219 46.210937 0 83.804687-37.59375 83.804687-83.804688 0-46.210937-37.59375-83.800781-83.804687-83.800781-46.210938 0-83.804688 37.59375-83.804688 83.804688 0 10.714843 2.046875 20.957031 5.726563 30.386718l-137.96875 85.453125c-15.339844-16.851562-37.441406-27.449219-61.972656-27.449219-46.210938 0-83.804688 37.597657-83.804688 83.804688 0 46.210938 37.59375 83.804688 83.804688 83.804688 24.53125 0 46.632812-10.59375 61.972656-27.449219l137.96875 85.453125c-3.679688 9.429687-5.726563 19.671875-5.726563 30.390625 0 46.207031 37.59375 83.800781 83.804688 83.800781 46.210937 0 83.804687-37.59375 83.804687-83.800781 0-46.210938-37.59375-83.804688-83.804687-83.804688zm-53.246094-260.589843c0-29.359376 23.886719-53.246094 53.246094-53.246094s53.246093 23.886718 53.246093 53.246094-23.886718 53.246093-53.246093 53.246093-53.246094-23.886719-53.246094-53.246093zm-224.773437 225.441406c-29.363282 0-53.25-23.886719-53.25-53.246094s23.886718-53.246094 53.25-53.246094c29.359374 0 53.242187 23.886719 53.242187 53.246094s-23.882813 53.246094-53.242187 53.246094zm224.773437 118.949218c0-29.359374 23.886719-53.246093 53.246094-53.246093s53.246093 23.886719 53.246093 53.246093-23.886718 53.246094-53.246093 53.246094-53.246094-23.886718-53.246094-53.246094z"/></svg></button></div><button type="button" class="kw-masha-feedly__close" data-masha-feedly-close-edit aria-label="<%t KW\MashaFeedly\Translations.DIALOG_CLOSE 'Dialog schließen' %>">×</button></header>
            <form data-masha-feedly-edit-form data-update-url="$UpdateEntryURL" data-security-id="$TokenValue">
                <input type="hidden" name="EntryID">
                <p class="kw-masha-feedly__selected-context" data-masha-feedly-edit-context></p>
                <div class="kw-masha-feedly__entry-relations" data-masha-feedly-edit-relations aria-label="<%t KW\MashaFeedly\Translations.ENTRY_RELATIONS_ARIA 'Verknüpfte Einträge' %>"></div>
                <div class="kw-masha-feedly__entry-description" data-masha-feedly-edit-description></div>
                <div class="kw-masha-feedly__entry-attachments" data-masha-feedly-edit-attachments></div>
                <label class="kw-masha-feedly__attachment-field">
                    <svg class="kw-masha-feedly__upload-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22,13a1,1,0,0,0-1,1v4.213A2.79,2.79,0,0,1,18.213,21H5.787A2.79,2.79,0,0,1,3,18.213V14a1,1,0,0,0-2,0v4.213A4.792,4.792,0,0,0,5.787,23H18.213A4.792,4.792,0,0,0,23,18.213V14A1,1,0,0,0,22,13Z"/><path d="M6.707,8.707,11,4.414V17a1,1,0,0,0,2,0V4.414l4.293,4.293a1,1,0,0,0,1.414-1.414l-6-6a1,1,0,0,0-1.414,0l-6,6A1,1,0,0,0,6.707,8.707Z"/></svg>
                    <span class="kw-masha-feedly__attachment-title">Weitere Dateien anhängen</span>
                    <span class="kw-masha-feedly__attachment-hint">Noch etwas, das beim Debuggen hilft?</span>
                    <input type="file" name="Attachments[]" aria-label="Weitere Dateien auswählen" multiple accept="image/jpeg,image/png,image/gif,image/webp,application/pdf,application/zip,.jpg,.jpeg,.png,.gif,.webp,.pdf,.zip">
                    <small>Maximal 10 MB pro Datei, 20 MB insgesamt</small>
                </label>
                <div class="kw-masha-feedly__form-grid"><label><%t KW\MashaFeedly\Translations.STATUS_LABEL 'Status' %><select name="CategoryID" data-masha-feedly-edit-category><% loop $Categories %><option value="$ID" data-system-key="$SystemKey">$Title</option><% end_loop %></select></label><label><%t KW\MashaFeedly\Translations.FIELD_PRIORITY 'Priorität' %><select name="PriorityID"><% loop $Priorities %><option value="$ID">$Title</option><% end_loop %></select></label><label><%t KW\MashaFeedly\Translations.FIELD_DUE_DATE 'Fällig am' %><input name="DueDate" type="date"></label></div>
                <% if $CanApproveEstimate %><section class="kw-masha-feedly__estimate" data-masha-feedly-estimate hidden aria-live="polite">
                    <div class="kw-masha-feedly__estimate-heading"><span aria-hidden="true">€</span><div><strong><%t KW\MashaFeedly\Translations.ESTIMATE_TITLE 'Kostenschätzung' %></strong><small data-masha-feedly-estimate-state></small></div></div>
                    <p class="kw-masha-feedly__estimate-lock" data-masha-feedly-estimate-lock hidden><%t KW\MashaFeedly\Translations.ESTIMATE_TRANSITION_LOCKED 'Der Eintrag kann erst nach Freigabe der Kostenschätzung weiter verschoben werden.' %></p>
                    <details class="kw-masha-feedly__estimate-readonly" data-masha-feedly-estimate-readonly hidden>
                        <summary><span class="kw-masha-feedly__estimate-small-label"><%t KW\MashaFeedly\Translations.ESTIMATE_DURATION 'Geschätzte Dauer' %></span><span class="kw-masha-feedly__estimate-duration-value" data-masha-feedly-estimate-duration></span><span class="kw-masha-feedly__estimate-small-label"><%t KW\MashaFeedly\Translations.ESTIMATE_TOTAL_PRICE 'Geschätzter Gesamtpreis' %></span><strong data-masha-feedly-estimate-amount></strong><span class="kw-masha-feedly__estimate-details-label"><%t KW\MashaFeedly\Translations.ESTIMATE_DETAILS_TOGGLE 'Details und Erläuterung' %></span></summary>
                        <div class="kw-masha-feedly__estimate-readonly-content"><p data-masha-feedly-estimate-note-row><strong><%t KW\MashaFeedly\Translations.ESTIMATE_NOTE 'Erläuterung' %>:</strong> <span data-masha-feedly-estimate-note></span></p><p data-masha-feedly-estimate-help></p></div>
                    </details>
                    <% if $CanManageEstimate %><div class="kw-masha-feedly__estimate-fields" data-masha-feedly-estimate-fields hidden>
                        <label><%t KW\MashaFeedly\Translations.ESTIMATE_DURATION 'Geschätzte Dauer' %><input name="EstimatedCostDuration" type="text" maxlength="80" placeholder="10 Minuten oder 2–4 Stunden" disabled></label>
                        <output class="kw-masha-feedly__estimate-price" data-masha-feedly-estimate-price></output>
                        <label class="kw-masha-feedly__estimate-note"><%t KW\MashaFeedly\Translations.ESTIMATE_NOTE 'Erläuterung' %><textarea name="EstimatedCostNote" rows="2" maxlength="2000" disabled></textarea></label>
                    </div><% end_if %>
                </section><% end_if %>
                <% if $Members %><fieldset class="kw-masha-feedly__assignees"><legend><%t KW\MashaFeedly\Translations.ASSIGNEES_SELECT 'Verantwortliche auswählen' %></legend><div><% loop $Members %><label class="kw-masha-feedly__assignee-choice" title="$Name"><input type="checkbox" name="AssignedMemberIDs[]" value="$ID"><span class="kw-masha-feedly__assignee-avatar" style="background-color: $Color" aria-label="$Name"><% if $ImageURL %><img src="$ImageURL" alt=""><% else %>$Initials<% end_if %></span><span class="kw-masha-feedly__assignee-name">$Name</span></label><% end_loop %></div></fieldset><% end_if %>
                <p class="kw-masha-feedly__form-status" data-masha-feedly-edit-status role="status" aria-live="polite" aria-atomic="true"></p>
                <footer class="kw-masha-feedly__dialog-actions"><button type="button" class="kw-masha-feedly__secondary" data-masha-feedly-close-edit><%t KW\MashaFeedly\Translations.EDIT_CLOSE 'Schließen' %></button><button type="submit" class="kw-masha-feedly__submit"><%t KW\MashaFeedly\Translations.EDIT_SAVE 'Änderungen speichern' %> <span aria-hidden="true">→</span></button></footer>
                <div class="kw-masha-feedly__edit-extra-details">
                    <details class="kw-masha-feedly__entry-environment-details" data-masha-feedly-edit-environment-details hidden><summary><%t KW\MashaFeedly\Translations.ENVIRONMENT_DETAILS 'Browser- und Seitendetails' %></summary><dl class="kw-masha-feedly__entry-environment" data-masha-feedly-edit-environment></dl></details>
                    <details class="kw-masha-feedly__entry-environment-details kw-masha-feedly__relations-details"><summary><span class="kw-masha-feedly__eyebrow"><%t KW\MashaFeedly\Translations.RELATIONS_EYEBROW 'ZUSAMMENHÄNGE' %></span> <strong><%t KW\MashaFeedly\Translations.RELATIONS_TITLE 'Verknüpfte Einträge' %></strong></summary><section class="kw-masha-feedly__relations" data-masha-feedly-relations><p><%t KW\MashaFeedly\Translations.RELATIONS_HELP 'Verknüpfe Einträge, wenn einer den anderen blockiert, ein Duplikat ist oder beide thematisch verwandt sind.' %></p><label><%t KW\MashaFeedly\Translations.RELATIONS_TYPE_LABEL 'Art der Verknüpfung' %><select name="RelationType" data-masha-feedly-relation-type><option value="related"><%t KW\MashaFeedly\Translations.RELATION_RELATED 'Thematisch verwandt' %></option><option value="blocked_by"><%t KW\MashaFeedly\Translations.RELATION_BLOCKED_BY 'Blockiert durch' %></option><option value="duplicate_of"><%t KW\MashaFeedly\Translations.RELATION_DUPLICATE_OF 'Duplikat von' %></option></select></label><label><%t KW\MashaFeedly\Translations.RELATIONS_ENTRIES_LABEL 'Einträge auswählen' %><input type="search" data-masha-feedly-relation-search placeholder="Einträge suchen …"><select name="RelatedEntryIDs[]" data-masha-feedly-related-entries multiple size="4"></select></label><small data-masha-feedly-relation-hint><%t KW\MashaFeedly\Translations.RELATIONS_PAGE_HINT 'Suche in allen Masha:Feedly-Einträgen.' %></small></section></details>
                    <details class="kw-masha-feedly__entry-environment-details kw-masha-feedly__history" aria-labelledby="kw-masha-feedly-history-title"><summary id="kw-masha-feedly-history-title"><%t KW\MashaFeedly\Translations.HISTORY_TITLE 'Verlauf' %> <span class="kw-masha-feedly__eyebrow"><%t KW\MashaFeedly\Translations.HISTORY_EYEBROW 'ÄNDERUNGEN' %></span></summary><ol class="kw-masha-feedly__history-list" data-masha-feedly-history aria-live="polite"></ol></details>
                </div>
            </form>
            <section class="kw-masha-feedly__comments" aria-labelledby="kw-masha-feedly-comments-title">
                <header class="kw-masha-feedly__comments-heading"><div><span class="kw-masha-feedly__eyebrow"><%t KW\MashaFeedly\Translations.COMMENTS_EYEBROW 'IM GESPRÄCH' %></span><h3 id="kw-masha-feedly-comments-title"><%t KW\MashaFeedly\Translations.COMMENTS_TITLE 'Kommentare' %></h3></div><span class="kw-masha-feedly__comment-count" data-masha-feedly-comment-count>0</span></header>
                <div class="kw-masha-feedly__comment-list" data-masha-feedly-comments aria-live="polite"></div>
                <form class="kw-masha-feedly__comment-form" data-masha-feedly-comment-form data-comment-url="$CommentEntryURL" data-security-id="$TokenValue">
                    <input type="hidden" name="EntryID">
                    <label for="kw-masha-feedly-comment-text"><% if $Address == 'sie' %><%t KW\MashaFeedly\Translations.COMMENT_LABEL_SIE 'Ihr Kommentar' %><% else %><%t KW\MashaFeedly\Translations.COMMENT_LABEL_DU 'Dein Kommentar' %><% end_if %></label>
                    <textarea id="kw-masha-feedly-comment-text" name="CommentText" rows="3" maxlength="5000" required placeholder="<% if $Address == 'sie' %><%t KW\MashaFeedly\Translations.COMMENT_PLACEHOLDER_SIE 'Schreiben Sie etwas dazu …' %><% else %><%t KW\MashaFeedly\Translations.COMMENT_PLACEHOLDER_DU 'Schreib etwas dazu …' %><% end_if %>"></textarea>
                    <small class="kw-masha-feedly__comment-link-hint"><%t KW\MashaFeedly\Translations.COMMENT_LINK_HINT 'Links mit https:// oder http:// werden automatisch anklickbar.' %></small>
                    <p class="kw-masha-feedly__form-status" data-masha-feedly-comment-status role="status" aria-live="polite" aria-atomic="true"></p>
                    <button type="submit" class="kw-masha-feedly__submit"><%t KW\MashaFeedly\Translations.COMMENT_SEND 'Kommentar senden' %> <span aria-hidden="true">→</span></button>
                </form>
            </section>
        </section>
    </div>
    <% if $CanManageMite %>
    <div class="kw-masha-feedly__modal" data-widget-mite-modal hidden data-options-url="$MiteOptionsURL" data-start-url="$MiteStartURL" data-stop-url="$MiteStopURL">
        <section class="kw-masha-feedly__dialog kw-masha-feedly__mite-dialog" role="dialog" aria-modal="true" aria-labelledby="kw-masha-feedly-mite-title">
            <header class="kw-masha-feedly__dialog-header"><div><span class="kw-masha-feedly__eyebrow">MITE</span><h2 id="kw-masha-feedly-mite-title" tabindex="-1"><%t KW\MashaFeedly\Translations.MITE_DIALOG_TITLE 'Mite-Timer starten?' %></h2></div><button type="button" class="kw-masha-feedly__close" data-widget-mite-close aria-label="<%t KW\MashaFeedly\Translations.CLOSE_MODAL 'Dialog schließen' %>">×</button></header>
            <form class="kw-masha-feedly__mite-form" data-mite-controls>
                <p class="kw-masha-feedly__selected-context" data-widget-mite-context><%t KW\MashaFeedly\Translations.MITE_DIALOG_DESCRIPTION 'Bei Bedarf startet hier die Zeiterfassung in Mite. Beschreibung und Seitenlink des Eintrags werden übernommen.' %></p>
                <label><%t KW\MashaFeedly\Translations.MITE_PROJECT 'Mite-Projekt' %><select data-widget-mite-project disabled></select></label>
                <label><%t KW\MashaFeedly\Translations.MITE_SERVICE 'Mite-Leistung' %><select data-widget-mite-service disabled></select></label>
                <p class="kw-masha-feedly__mite-active" data-widget-mite-active></p><p class="kw-masha-feedly__form-status" data-widget-mite-status role="status" aria-live="polite"></p>
                <footer class="kw-masha-feedly__dialog-actions"><button type="button" class="kw-masha-feedly__secondary" data-widget-mite-refresh><%t KW\MashaFeedly\Translations.MITE_REFRESH 'Neu laden' %></button><button type="button" class="kw-masha-feedly__secondary" data-widget-mite-close><%t KW\MashaFeedly\Translations.MITE_SKIP 'Ohne Timer weiter' %></button><button type="button" class="kw-masha-feedly__secondary" data-widget-mite-stop hidden><%t KW\MashaFeedly\Translations.MITE_STOP 'Timer stoppen' %></button><button type="button" class="kw-masha-feedly__submit" data-widget-mite-start disabled><%t KW\MashaFeedly\Translations.MITE_START 'Timer starten' %></button></footer>
            </form>
        </section>
    </div>
    <% end_if %>
</div>
