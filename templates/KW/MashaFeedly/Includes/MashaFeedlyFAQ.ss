<div class="kw-masha-feedly__modal kw-masha-feedly__faq-modal" id="kw-masha-feedly-faq" data-masha-feedly-faq-modal hidden>
    <section class="kw-masha-feedly__dialog kw-masha-feedly__faq-dialog" role="dialog" aria-modal="true" aria-labelledby="kw-masha-feedly-faq-title">
        <header class="kw-masha-feedly__faq-header">
            <span class="kw-masha-feedly__faq-emblem"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 6.5C9.6 4.6 6.7 4.5 3 5.5v14c3.7-1 6.6-.9 9 1 2.4-1.9 5.3-2 9-1v-14c-3.7-1-6.6-.9-9 1Zm0 0v14M6.5 9h2M6.5 12h2M15.5 9h2M15.5 12h2"/></svg></span>
            <div><span class="kw-masha-feedly__faq-kicker">FAQ · Masha:Feedly</span><h2 id="kw-masha-feedly-faq-title" tabindex="-1"><%t KW\MashaFeedly\Translations.FAQ_TITLE 'Alles klar. Schritt für Schritt.' %></h2><p><%t KW\MashaFeedly\Translations.FAQ_INTRO 'Melden, finden, gemeinsam weiterkommen. Hier wird Masha:Feedly einfach erklärt – ohne Vorwissen.' %></p></div>
            <button class="kw-masha-feedly__close" type="button" data-masha-feedly-close-faq aria-label="<%t KW\MashaFeedly\Translations.FAQ_CLOSE 'FAQ schließen' %>">×</button>
        </header>
        <div class="kw-masha-feedly__faq-tools">
            <label class="kw-masha-feedly__faq-search"><span class="kw-masha-feedly__sr-only"><%t KW\MashaFeedly\Translations.FAQ_SEARCH 'Fragen durchsuchen' %></span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input type="search" data-masha-feedly-faq-search placeholder="<%t KW\MashaFeedly\Translations.FAQ_PLACEHOLDER 'Zum Beispiel: Screenshot, Status, E-Mail …' %>" autocomplete="off"></label>
            <nav class="kw-masha-feedly__faq-topics" aria-label="<%t KW\MashaFeedly\Translations.FAQ_TOPICS 'Themenbereiche' %>">
                <button type="button" data-masha-feedly-faq-topic="all" aria-pressed="true"><%t KW\MashaFeedly\Translations.FAQ_ALL 'Alle Themen' %></button>
                <button type="button" data-masha-feedly-faq-topic="START" aria-pressed="false"><%t KW\MashaFeedly\Translations.FAQ_GROUP_START 'Loslegen' %></button>
                <button type="button" data-masha-feedly-faq-topic="FILES" aria-pressed="false"><%t KW\MashaFeedly\Translations.FAQ_GROUP_FILES 'Bilder & Dateien' %></button>
                <button type="button" data-masha-feedly-faq-topic="FIND" aria-pressed="false"><%t KW\MashaFeedly\Translations.FAQ_GROUP_FIND 'Finden & Sortieren' %></button>
                <button type="button" data-masha-feedly-faq-topic="WORK" aria-pressed="false"><%t KW\MashaFeedly\Translations.FAQ_GROUP_WORK 'Bearbeiten & Freigeben' %></button>
                <button type="button" data-masha-feedly-faq-topic="TALK" aria-pressed="false"><%t KW\MashaFeedly\Translations.FAQ_GROUP_TALK 'Kommentare & Verlauf' %></button>
                <button type="button" data-masha-feedly-faq-topic="PROFILE" aria-pressed="false"><%t KW\MashaFeedly\Translations.FAQ_GROUP_PROFILE 'Profil & E-Mails' %></button>
                <button type="button" data-masha-feedly-faq-topic="EXTRA" aria-pressed="false"><%t KW\MashaFeedly\Translations.FAQ_GROUP_EXTRA 'Gut zu wissen' %></button>
            </nav>
        </div>
        <div class="kw-masha-feedly__faq-content" data-masha-feedly-faq-content>
            <p class="kw-masha-feedly__faq-count" data-masha-feedly-faq-count data-count-label="<%t KW\MashaFeedly\Translations.FAQ_COUNT '{count} Antworten' %>" role="status" aria-live="polite"></p>
            <section class="kw-masha-feedly__faq-group" data-masha-feedly-faq-group="START" aria-labelledby="kw-masha-feedly-faq-START">
                <h3 id="kw-masha-feedly-faq-START"><span aria-hidden="true">01</span><%t KW\MashaFeedly\Translations.FAQ_GROUP_START 'Loslegen' %></h3>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_PURPOSE_Q 'Was ist Masha:Feedly?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_PURPOSE_A 'Ein gemeinsamer Ort für Fehler, Fragen und Änderungswünsche direkt auf dieser Website. Jede Meldung zeigt, worum es geht, wer sich kümmert und wie weit die Bearbeitung ist. Kommentare bleiben bei der passenden Meldung. So muss niemand Informationen aus mehreren E-Mails zusammensuchen.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_OPEN_PANEL_Q 'Wie öffne ich das Masha:Feedly-Panel?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_OPEN_PANEL_A 'Klicke oder tippe auf die Lasche am rechten Bildschirmrand. Am Computer kannst du die Lasche auch mit der Maus nach links herausziehen. Sobald du sie weit genug ziehst, öffnet sich das Panel.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_CREATE_Q 'Wie erstelle ich eine Meldung?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_CREATE_A 'Das pinke Plus im ersten Panel anklicken. Danach auf die betroffene Stelle der Website klicken. Im Formular kurz beschreiben, was nicht stimmt oder geändert werden soll. Bei Bedarf Bilder oder Dateien anhängen. Erst „Meldung speichern“ legt die Meldung an. Beispiel: „Der Kontakt-Button öffnet eine leere Seite.“' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_MARKER_Q 'Was bedeutet die Markierung auf der Website?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_MARKER_A 'Die nummerierte Markierung sitzt an der Stelle, die beim Erstellen angeklickt wurde. Ein Klick darauf öffnet die Meldung. Ihre Farbe zeigt die Priorität. Markierungen erscheinen für offene Meldungen der aktuellen Seite, solange Masha:Feedly geöffnet ist. Erledigte Meldungen bleiben in der Liste, bekommen aber keine offene Markierung.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_DESCRIPTION_Q 'Was gehört in eine gute Beschreibung?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_DESCRIPTION_A 'Was passiert? Was sollte eigentlich passieren? Welcher Button oder Bereich ist betroffen? Ein konkretes Beispiel hilft mehr als „geht nicht“. Unter „Schritte zum Nachstellen“ lassen sich die einzelnen Klicks, das erwartete Ergebnis und das tatsächliche Ergebnis ergänzen. Dieser Bereich ist freiwillig.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_CANCEL_Q 'Kann ich die Bereichsauswahl abbrechen?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_CANCEL_A 'Ja. Während der Auswahl „Abbrechen“ anklicken oder die Esc-Taste drücken. Dabei wird noch keine Meldung gespeichert. Das Formular kann ebenfalls geschlossen werden, bevor „Meldung speichern“ gewählt wird.' %></p></div></details>
            </section>
            <section class="kw-masha-feedly__faq-group" data-masha-feedly-faq-group="FILES" aria-labelledby="kw-masha-feedly-faq-FILES">
                <h3 id="kw-masha-feedly-faq-FILES"><span aria-hidden="true">02</span><%t KW\MashaFeedly\Translations.FAQ_GROUP_FILES 'Bilder & Dateien' %></h3>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_ATTACHMENTS_Q 'Wie füge ich Bilder oder Dateien hinzu?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_ATTACHMENTS_A 'Im Formular die gewünschten Dateien auswählen. Bei einer bestehenden Meldung gibt es „Weitere Dateien anhängen“. Neue Anhänge werden erst zusammen mit der Meldung oder den Änderungen gespeichert. Die erlaubten Dateitypen und Größen stehen am Upload-Feld; hier gelten höchstens 10 MB pro Datei und 20 MB insgesamt.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_SCREENSHOT_Q 'Wie funktioniert „Screenshot hinzufügen“?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_SCREENSHOT_A 'Der Browser fragt zuerst, welcher Tab, welches Fenster oder welcher Bildschirm aufgenommen werden darf. Die betroffene Website auswählen. Danach auf eine Ecke des gewünschten Ausschnitts und auf die gegenüberliegende Ecke klicken. „Ausschnitt übernehmen“ fügt das Bild hinzu. „Screenshot entfernen“ verwirft es.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_SENSITIVE_Q 'Was mache ich mit vertraulichen Bildinhalten?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_SENSITIVE_A 'Passwörter, private Nachrichten und andere vertrauliche Inhalte außerhalb des Screenshot-Ausschnitts lassen. Einzelne Stellen können im Werkzeug nicht geschwärzt werden. Alternativ das Bild vorher selbst bearbeiten und als Datei anhängen. Wenn die Browseraufnahme nicht funktioniert, ist ein normaler Bildanhang genauso möglich.' %></p></div></details>
            </section>
            <section class="kw-masha-feedly__faq-group" data-masha-feedly-faq-group="FIND" aria-labelledby="kw-masha-feedly-faq-FIND">
                <h3 id="kw-masha-feedly-faq-FIND"><span aria-hidden="true">03</span><%t KW\MashaFeedly\Translations.FAQ_GROUP_FIND 'Finden & Sortieren' %></h3>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_COUNTERS_Q 'Was zeigen die Zahlen im ersten Panel?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_COUNTERS_A '„Ganze Website“ öffnet offene Meldungen auf allen Seiten. „Diese Seite“ zeigt offene Meldungen der gerade sichtbaren Seite. Das Häkchen führt zu erledigten Meldungen. Die Zahlen zählen Meldungen und keine Kommentare. Je nach vorhandenen Meldungen erscheinen zusätzliche Buttons für Neuigkeiten, Feedback und Kostenschätzungen.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_NEWS_Q 'Was bedeutet „Neuigkeiten“?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_NEWS_A 'Hier stehen Meldungen mit neuer Aktivität seit dem persönlichen Lesestand. Dazu zählen neue oder geänderte Meldungen und neue Kommentaraktivität. Beim Öffnen einer Meldung wird ihr aktueller Stand als gelesen markiert. Das ist unabhängig von E-Mail-Benachrichtigungen: Auch ohne E-Mail bleiben Neuigkeiten im Werkzeug sichtbar.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_FILTERS_Q 'Wie finde ich eine bestimmte Meldung?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_FILTERS_A 'Eine Liste öffnen und „Filter“ aufklappen. Dort lassen sich die angebotenen Filter kombinieren, zum Beispiel Status, Priorität und persönliche Zuständigkeit. Aktive Filter stehen als kleine Chips über der Liste. Ein Chip lässt sich einzeln entfernen; „Alle Filter zurücksetzen“ hebt die gesamte Auswahl auf.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_SAVED_Q 'Kann ich meine Filter speichern?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_SAVED_A 'Ja. Die gewünschte Kombination auswählen, ihr einen verständlichen Namen geben und als persönliche Ansicht speichern. Die Ansicht kann später wieder ausgewählt oder gelöscht werden. Sie gehört zum eigenen Konto und verändert die Ansichten anderer Personen nicht.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_SORT_Q 'Wie ändere ich die Reihenfolge?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_SORT_A 'Die Sortierung oberhalb der Meldungsliste öffnen. Zur Auswahl stehen unter anderem Fälligkeit, Erstellungszeit, Priorität, letzte Aktivität und Zuständigkeit. Ein erneuter Klick auf das aktive Kriterium kehrt die Richtung um. Meldungen ohne Fälligkeit stehen bei der Terminsortierung hinter Meldungen mit Termin.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_LINK_Q 'Wie teile ich eine Meldung?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_LINK_A 'Den Teilen-Button auf der Meldungskarte oder im geöffneten Meldungsfenster verwenden. Er kopiert einen direkten Link zu genau dieser Meldung. Die empfangende Person muss angemeldet und für Masha:Feedly freigeschaltet sein. Ein geteilter Link macht eine Meldung nicht öffentlich.' %></p></div></details>
            </section>
            <section class="kw-masha-feedly__faq-group" data-masha-feedly-faq-group="WORK" aria-labelledby="kw-masha-feedly-faq-WORK">
                <h3 id="kw-masha-feedly-faq-WORK"><span aria-hidden="true">04</span><%t KW\MashaFeedly\Translations.FAQ_GROUP_WORK 'Bearbeiten & Freigeben' %></h3>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_EDIT_Q 'Wie ändere ich eine Meldung?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_EDIT_A 'Die Meldung öffnen. Die angebotenen Felder lassen sich bearbeiten, zum Beispiel Status, Priorität, Fälligkeit und Verantwortliche. Danach „Änderungen speichern“ anklicken und auf die Bestätigung warten. Welche Felder verfügbar sind, hängt von den persönlichen Berechtigungen ab.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_STATUS_Q 'Was bedeuten Status und Priorität?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_STATUS_A 'Der Status beschreibt den Arbeitsstand: zum Beispiel Backlog für vorgemerkt, Todo für als Nächstes, Doing für in Arbeit und Done für erledigt. Die Website kann andere Namen verwenden. Die Priorität beschreibt, wie dringend etwas ist. Eine hohe Priorität macht eine Meldung nicht automatisch erledigt.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_ASSIGNEES_Q 'Wie lege ich fest, wer sich kümmert?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_ASSIGNEES_A 'Unter „Verantwortliche auswählen“ die passenden Profilbilder anklicken. Mehrere Personen sind möglich. Ein erneuter Klick entfernt eine Person aus der Auswahl. Beim Darüberfahren oder Tastaturfokus erscheint der Name. Die neue Auswahl gilt nach „Änderungen speichern“.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_DUE_Q 'Wozu ist „Fällig am“ da?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_DUE_A 'Hier lässt sich ein gewünschter Termin eintragen. Er erscheint auf der Karte und hilft beim Sortieren. Wenn Erinnerungen eingerichtet sind, erhalten Personen mit aktivierter Fälligkeitserinnerung einmal eine E-Mail am Fälligkeitstag oder beim nächsten Erinnerungslauf. Der persönliche E-Mail-Bereich bestimmt, welche Meldungen dazugehören. Eine Terminänderung setzt die Erinnerung zurück.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_FEEDBACK_Q 'Warum wartet eine erledigte Meldung auf Feedback?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_FEEDBACK_A 'Wenn eine andere Person die Arbeit abschließt, kann die Meldung zunächst auf Feedback wechseln. Das heißt: Das Ergebnis soll noch geprüft werden. Die Meldung öffnen, die Änderung auf der Website ansehen und bei passendem Ergebnis abschließen. Wenn noch etwas fehlt, einen konkreten Kommentar hinterlassen.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_ESTIMATE_Q 'Wie funktioniert eine Kostenschätzung?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_ESTIMATE_A 'Bei freigabepflichtiger Arbeit kann eine Kostenschätzung angefragt werden. Berechtigte Personen tragen Aufwand und Erläuterung ein; aus dem hinterlegten Stundensatz wird der Preis berechnet. Die zuständige freigabeberechtigte Person prüft und genehmigt die Schätzung. Die Warteschlangen zeigen offene und bereits freigegebene Schätzungen. Diese Funktionen erscheinen nur mit den nötigen Berechtigungen.' %></p></div></details>
            </section>
            <section class="kw-masha-feedly__faq-group" data-masha-feedly-faq-group="TALK" aria-labelledby="kw-masha-feedly-faq-TALK">
                <h3 id="kw-masha-feedly-faq-TALK"><span aria-hidden="true">05</span><%t KW\MashaFeedly\Translations.FAQ_GROUP_TALK 'Kommentare & Verlauf' %></h3>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_COMMENT_Q 'Wie schreibe ich einen Kommentar?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_COMMENT_A 'Die Meldung öffnen und unten im Bereich „Kommentare“ die Nachricht eingeben. „Kommentar senden“ speichert sie bei dieser Meldung. Links mit http:// oder https:// werden anklickbar. Kommentare eignen sich für Rückfragen, Antworten und Hinweise zum Ergebnis.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_REACTION_Q 'Wie reagiere ich mit einem Emoji?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_REACTION_A 'Beim Kommentar den Smiley anklicken und eine Reaktion auswählen. Eine Reaktion zeigt zum Beispiel Zustimmung oder Dank, ohne einen weiteren Kommentar zu schreiben. Die Zahl am Emoji zeigt, wie viele Personen so reagiert haben. Ein bestehendes Emoji kann ebenfalls angeklickt werden.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_COMMENT_EDIT_Q 'Kann ich einen Kommentar bearbeiten oder löschen?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_COMMENT_EDIT_A 'Wenn die entsprechenden Buttons angezeigt werden, kann der Kommentar bearbeitet oder gelöscht werden. Die Änderung muss bestätigt werden. Die Berechtigungen entscheiden, welche Kommentare geändert werden dürfen. Wichtige Änderungen bleiben im Verlauf nachvollziehbar.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_HISTORY_Q 'Was steht im Verlauf?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_HISTORY_A 'Der Verlauf zeigt, wer wann etwas geändert hat: zum Beispiel Status, Priorität, Verantwortliche, Kommentare, Anhänge und Zusammenhänge. „Verlauf“ anklicken, um ihn aufzuklappen. Er wird erst dann geladen. So öffnet sich die Meldung schneller.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_RELATIONS_Q 'Was sind „Zusammenhänge“?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_RELATIONS_A 'Hier lassen sich Meldungen miteinander verknüpfen. „Verwandt“ bedeutet: Die Themen gehören zusammen. „Blockiert durch“ bedeutet: Erst muss die andere Meldung bearbeitet werden. „Duplikat“ bedeutet: Dasselbe Problem wurde schon gemeldet. Beim Abschluss der Hauptmeldung werden ihre Duplikate ebenfalls abgeschlossen.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_ENVIRONMENT_Q 'Was sind „Browser- und Seitendetails“?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_ENVIRONMENT_A 'Beim Melden werden technische Hinweise wie Browser, Betriebssystem und Bildschirmgröße festgehalten. Dazu kommen die Seite und die ausgewählte Stelle. Diese Angaben helfen, ein Problem nachzustellen. Sie stehen in der geöffneten Meldung im aufklappbaren Bereich „Browser- und Seitendetails“.' %></p></div></details>
            </section>
            <section class="kw-masha-feedly__faq-group" data-masha-feedly-faq-group="PROFILE" aria-labelledby="kw-masha-feedly-faq-PROFILE">
                <h3 id="kw-masha-feedly-faq-PROFILE"><span aria-hidden="true">06</span><%t KW\MashaFeedly\Translations.FAQ_GROUP_PROFILE 'Profil & E-Mails' %></h3>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_PRIVACY_Q 'Wer kann Meldungen und Dateien sehen?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_PRIVACY_A 'Nur angemeldete Personen, die für Masha:Feedly freigeschaltet sind. Das gilt auch für Kommentare und Anhänge. Ein normales Website-Konto allein reicht dafür nicht aus. Die Freischaltung verwaltet die zuständige Administration.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_PROFILE_Q 'Wo ändere ich mein Profil?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_PROFILE_A '„Profileinstellungen öffnen“ führt zum persönlichen Profil. Dort lassen sich Profilfarbe, Profilbild oder verfügbares Symbol, Anrede, Danke-Animation und E-Mail-Auswahl einstellen. Änderungen in einer Vorschau werden erst dauerhaft übernommen, wenn das Profil gespeichert wird.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_EMAILS_Q 'Welche E-Mails kann ich erhalten?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_EMAILS_A 'Im Profil gibt es E-Mails zu neuen Meldungen und Zuweisungen, Änderungen, Kommentaren, Fälligkeiten und Kostenschätzungen. Die Häkchen bestimmen die Ereignisse, die Bereichsauswahl bestimmt die Meldungen. Eigene Aktionen erzeugen keine Mail. Der Link „E-Mail-Einstellungen ändern“ im Mail-Footer öffnet das Profil. Neuigkeiten im Werkzeug funktionieren unabhängig davon.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_EMAIL_SCOPE_Q 'Was ist der Unterschied zwischen „Alle Meldungen“ und „Meine Meldungen“?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_EMAIL_SCOPE_A '„Alle Meldungen“ bedeutet: E-Mails zu allen freigegebenen Meldungen der Website, einschließlich Kommentaren und Fälligkeiten. „Meine Meldungen“ bedeutet: nur selbst erstellte oder aktuell zugewiesene Meldungen. Für beide Bereiche gelten die ausgewählten Ereignis-Häkchen. Neue Zuweisungen zählen zu „Neue Meldungen und neue Zuweisungen“. Nach dem Entfernen einer Zuweisung gehört die Meldung nur noch dann zu „Meine Meldungen“, wenn sie selbst erstellt wurde. Eigene Meldungen, Änderungen und Kommentare lösen keine E-Mail an die handelnde Person aus. Kostenschätzungen zur Freigabe gehen ausschließlich an Zuständige mit aktivierter Benachrichtigung. Die Hauptoption schaltet alle Benachrichtigungen aus und blendet die Auswahl aus; beim Einschalten erscheint die gespeicherte Auswahl wieder. Bei jeder neuen oder erneuten Freigabe startet die Person mit „Meine Meldungen“ und eingeschalteten Ereignisarten. Die Willkommensmail kommt unabhängig vom E-Mail-Schalter.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_EMAIL_LOCKED_Q 'Warum kann ich E-Mails noch nicht aktivieren?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_EMAIL_LOCKED_A 'Die Website-Administration muss zuerst den E-Mail-Versand erfolgreich testen. Bis dahin bleiben die persönlichen E-Mail-Optionen gesperrt. Wenn eine erwartete Mail fehlt, auch den Spam-Ordner prüfen und die zuständige Administration ansprechen. Die gespeicherte Meldung bleibt auch bei einem Versandfehler erhalten.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_EFFECTS_Q 'Was sind die Danke-Animationen?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_EFFECTS_A 'Nach einem bestätigten Abschluss kann eine kurze Animation erscheinen. Im Profil lässt sich die bevorzugte Kategorie wählen und die Tonwiedergabe ausschalten. Bei reduzierter Bewegung im Betriebssystem werden Animationen unterdrückt. Die Animation ist eine kleine Bestätigung und hat keinen Einfluss auf den gespeicherten Status. Ohne eingerichteten Anbieter wird keine Anfrage für Danke-Animationen gestartet; dann ist die lokale Häkchen-Animation verfügbar.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_TOUR_Q 'Wie starte ich die Einführung noch einmal?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_TOUR_A 'In der Kurzhilfe den Button zum Neustart der Einführung verwenden. Die Option ist auch im Profil verfügbar. Die Einführung führt durch das Erstellen, Kommentieren und Bearbeiten. Mit „Einführung beenden“ oder Esc lässt sie sich schließen. Auf kleinen Bildschirmen wird auf die Desktop-Variante verwiesen.' %></p></div></details>
            </section>
            <section class="kw-masha-feedly__faq-group" data-masha-feedly-faq-group="EXTRA" aria-labelledby="kw-masha-feedly-faq-EXTRA">
                <h3 id="kw-masha-feedly-faq-EXTRA"><span aria-hidden="true">07</span><%t KW\MashaFeedly\Translations.FAQ_GROUP_EXTRA 'Gut zu wissen' %></h3>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_MOBILE_Q 'Was geht auf dem Handy?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_MOBILE_A 'Auf dem Handy stehen das Plus zum Melden und die Kurzhilfe zur Verfügung. Die vollständige Meldungsliste, Bearbeitung und diese ausführliche FAQ sind für die Desktop-Variante gedacht. Dafür dieselbe Website auf einem Computer öffnen und mit dem freigeschalteten Konto anmelden.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_ERROR_Q 'Was tun, wenn Laden oder Speichern nicht klappt?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_ERROR_A 'Beim Laden kann die Meldung geschlossen und erneut geöffnet werden. Bei einer abgelaufenen Sitzung die Website neu laden und wieder anmelden. Wenn unklar ist, ob gespeichert wurde, zuerst die Liste oder Meldung neu öffnen und prüfen. Erst danach erneut senden, damit keine doppelte Meldung entsteht.' %></p></div></details>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_CMS_Q 'Was kann ich im CMS machen?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_CMS_A 'Mit entsprechendem CMS-Zugang gibt es zusätzlich ein Board mit Meldungen nach Status. Karten können bearbeitet und per Ziehen verschoben werden. Die Administration verwaltet dort Kategorien, Prioritäten und Website-Einstellungen. Der CMS-Zugang und die einzelnen Rechte werden separat vergeben.' %></p></div></details>
                <% if $CanManageMite %>
                <details class="kw-masha-feedly__faq-item" data-masha-feedly-faq-item><summary><%t KW\MashaFeedly\Translations.FAQ_MITE_Q 'Wozu ist der Mite-Timer da?' %><span aria-hidden="true">+</span></summary><div><p><%t KW\MashaFeedly\Translations.FAQ_MITE_A 'Wenn die Zeiterfassung eingerichtet und freigegeben ist, öffnet der Timer-Button Mite. Projekt und Leistung auswählen, dann den Timer ausdrücklich starten. Ein Statuswechsel allein startet keine Zeiterfassung. „Ohne Timer weiter“ setzt die Arbeit ohne Timer fort. Ein laufender Timer kann im Dialog gestoppt werden.' %></p></div></details>
                <% end_if %>
            </section>
            <div class="kw-masha-feedly__faq-empty" data-masha-feedly-faq-empty hidden><strong><%t KW\MashaFeedly\Translations.FAQ_EMPTY 'Noch keine passende Antwort gefunden.' %></strong><p><%t KW\MashaFeedly\Translations.FAQ_EMPTY_HINT 'Einen kürzeren Suchbegriff versuchen oder alle Themen auswählen.' %></p><button type="button" data-masha-feedly-faq-reset><%t KW\MashaFeedly\Translations.FAQ_RESET 'Suche zurücksetzen' %></button><p><%t KW\MashaFeedly\Translations.FAQ_CREATE_ENTRY_HINT 'Du kannst die Frage als Meldung einreichen. Danach einen Seitenbereich auswählen und die Beschreibung ergänzen.' %></p><button type="button" data-masha-feedly-faq-create-entry><%t KW\MashaFeedly\Translations.FAQ_CREATE_ENTRY 'Als Meldung einreichen' %></button></div>
        </div>
    </section>
</div>
