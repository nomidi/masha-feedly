MASHA_PROVIDER_URL=https://kooperative-web.de
MASHA_API_KEY=EINMALIGER_WEBSITE_SCHLUESSEL_AUS_SUITE_ADMIN
# Nur für lokale Speicherung sensibler Daten, beispielsweise Prism-Verbindungsdaten:
MASHA_ENCRYPTION_KEY=BASE64_KODIERTER_32_BYTE_SCHLUESSEL_DIESER_INSTALLATION

# Optional: Mehrzeiliger Footer für Masha:Feedly-E-Mails. Zeilenumbrüche als \n schreiben.
# Den echten Inhalt nur in der lokalen .env oder der Serverumgebung hinterlegen.
MASHA_FEEDLY_EMAIL_FOOTER=

# Gemeinsames CMS-Betreiberkonto; Zuordnung im Host unter app/_config.php. Kein SMTP-Absender.
MASHA_OPERATOR_EMAIL=betreiber@example.org
# Alter Name MASHA_FEEDLY_REPORTER_MANAGER_EMAIL wird im Host nur als Rückfall gelesen.
